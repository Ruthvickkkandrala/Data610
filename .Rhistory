View(diffinv)
# covid-19 regional analysis
# main question:
# does higher test positivity help explain which regions end up
# with higher covid-19 mortality per 100k, after accounting for
# case burden and population density?
library(tidyverse)
library(COVID19)
library(zoo)
library(glmnet)
library(randomForest)
library(pROC)
set.seed(42)
dir.create("figures", showWarnings = FALSE)
dir.create("tables",  showWarnings = FALSE)
# 1. load and clean data
df_raw <- covid19(level = 2, verbose = FALSE)
# step 1: keep regions with at least some reasonable reporting
df_comp <- df_raw %>%
group_by(administrative_area_level_2) %>%
summarise(
pct_na_confirmed = mean(is.na(confirmed)) * 100,
pct_na_deaths    = mean(is.na(deaths)) * 100,
.groups = "drop"
)
regions_keep <- df_comp %>%
filter(
pct_na_confirmed < 50,
pct_na_deaths    < 50
) %>%
pull(administrative_area_level_2)
df_filt <- df_raw %>%
filter(administrative_area_level_2 %in% regions_keep) %>%
arrange(administrative_area_level_2, date)
cat("regions after completeness filter:", length(regions_keep), "\n")
# step 2: simple imputation within each region time series
df_imp <- df_filt %>%
group_by(administrative_area_level_2) %>%
arrange(date) %>%
mutate(
confirmed = na.locf(confirmed, na.rm = FALSE),
deaths    = na.locf(deaths,    na.rm = FALSE),
tests     = na.approx(tests,   na.rm = FALSE)
) %>%
ungroup()
# step 3: snapshot per region + rate calculation + basic outlier filter
df_snap <- df_imp %>%
group_by(administrative_area_level_2) %>%
slice_tail(n = 1) %>%
ungroup() %>%
mutate(
cases_per_100k  = (confirmed / population) * 1e5,
deaths_per_100k = (deaths    / population) * 1e5,
cfr             = deaths / (confirmed + 1),
test_positivity = confirmed / (tests + 1),
tests_per_case  = tests / (confirmed + 1),
pop_density_log = log10(population + 1)
) %>%
filter(
population        > 0,
cases_per_100k    > 0,
deaths_per_100k   > 0,
test_positivity   > 0,
test_positivity   < 20,
deaths_per_100k   < 5000,
cfr               < 0.05,
is.finite(cfr)
) %>%
select(
administrative_area_level_2,
cases_per_100k,
deaths_per_100k,
cfr,
test_positivity,
tests_per_case,
pop_density_log
) %>%
drop_na()
df <- df_snap
cat("final dataset:", nrow(df), "regions\n")
print(head(df, 3))
# 2. basic exploratory analysis
med_deaths <- median(df$deaths_per_100k)
iqr_deaths <- IQR(df$deaths_per_100k)
cor_cases_cfr <- cor(df$cases_per_100k, df$cfr)
eda_summary <- tibble::tibble(
metric = c(
"Median deaths per 100k",
"IQR deaths per 100k",
"CFR min",
"CFR max",
"Corr(cases_per_100k, CFR)"
),
value = c(
round(med_deaths, 1),
round(iqr_deaths, 1),
round(min(df$cfr), 4),
round(max(df$cfr), 4),
round(cor_cases_cfr, 2)
)
)
eda_summary
cor_vars <- c("cases_per_100k", "deaths_per_100k",
"cfr", "test_positivity", "tests_per_case")
cor_mat <- cor(df[, cor_vars])
write.csv(round(cor_mat, 3),
"tables/correlation_matrix.csv",
row.names = TRUE)
cat("correlation matrix written to tables/correlation_matrix.csv\n")
pdf("figures/fig1_eda_simple.pdf", width = 10, height = 6)
par(mfrow = c(2, 3), mar = c(4, 4, 2.5, 1))
hist(df$deaths_per_100k,
main   = "mortality distribution",
xlab   = "deaths per 100k",
breaks = 30,
col    = "steelblue3",
border = "white",
las    = 1)
abline(v = med_deaths, col = "red3", lty = 2, lwd = 2)
plot(df$cases_per_100k, df$deaths_per_100k,
main = "cases vs deaths",
xlab = "cases per 100k",
ylab = "deaths per 100k",
pch  = 19,
col  = adjustcolor("dodgerblue", alpha = 0.4),
las  = 1)
plot(df$cases_per_100k, df$cfr,
main = "cases vs cfr",
xlab = "cases per 100k",
ylab = "cfr",
pch  = 19,
col  = adjustcolor("firebrick", alpha = 0.4),
las  = 1)
plot(df$test_positivity, df$deaths_per_100k,
main = "positivity vs mortality",
xlab = "test positivity",
ylab = "deaths per 100k",
pch  = 19,
col  = adjustcolor("purple", alpha = 0.4),
las  = 1)
plot(df$tests_per_case, df$cfr,
main = "tests per case vs cfr",
xlab = "tests per case",
ylab = "cfr",
pch  = 19,
col  = adjustcolor("orange", alpha = 0.4),
las  = 1)
boxplot(deaths_per_100k ~ cut(test_positivity, breaks = 4),
data = df,
main = "mortality by positivity quartile",
xlab = "test positivity group",
ylab = "deaths per 100k",
col  = c("lightgreen", "yellow", "orange", "red"),
las  = 1)
dev.off()
# 3. define outcome and predictors
mortality_cut <- median(df$deaths_per_100k)
df_model <- df %>%
dplyr::mutate(
high_mortality = as.numeric(deaths_per_100k > mortality_cut)
)
x_vars <- c(
"cases_per_100k",
"test_positivity",
"tests_per_case",
"pop_density_log"
)
df_model <- df_model %>%
dplyr::select(dplyr::all_of(x_vars), high_mortality) %>%
tidyr::drop_na()
set.seed(42)
idx_train <- sample(seq_len(nrow(df_model)), size = 0.7 * nrow(df_model))
x_train <- as.matrix(df_model[idx_train, x_vars])
y_train <- df_model$high_mortality[idx_train]
x_test  <- as.matrix(df_model[-idx_train, x_vars])
y_test  <- df_model$high_mortality[-idx_train]
# compact modeling summary
modeling_summary <- tibble::tibble(
set       = c("Total", "Train", "Test"),
n         = c(nrow(df_model), length(y_train), length(y_test)),
positives = c(
sum(df_model$high_mortality),
sum(y_train),
sum(y_test)
),
negatives = c(
nrow(df_model) - sum(df_model$high_mortality),
length(y_train) - sum(y_train),
length(y_test) - sum(y_test)
)
)
modeling_summary
# 4. LASSO logistic model
cv_lasso <- cv.glmnet(
x_train, y_train,
family       = "binomial",
alpha        = 1,
type.measure = "auc",
nfolds       = 10
)
lambda_star <- cv_lasso$lambda.1se
mod_lasso <- glmnet(
x_train, y_train,
family = "binomial",
alpha  = 1,
lambda = lambda_star
)
pred_lasso <- predict(mod_lasso, x_test, type = "response")[, 1]
roc_lasso  <- pROC::roc(y_test, pred_lasso, quiet = TRUE)
auc_lasso  <- as.numeric(pROC::auc(roc_lasso))
coef_vec <- coef(mod_lasso)[, 1]
coef_nz  <- coef_vec[coef_vec != 0]
coef_df <- data.frame(
predictor   = names(coef_nz),
coefficient = coef_nz,
odds_ratio  = exp(coef_nz),
row.names   = NULL
)
write.csv(
coef_df,
"tables/lasso_coefficients_simple.csv",
row.names = FALSE
)
lasso_summary <- tibble::tibble(
model    = "LASSO",
test_auc = round(auc_lasso, 3)
)
lasso_summary
# 5. Random forest model
df_train <- df_model[idx_train, ]
df_test  <- df_model[-idx_train, ]
mod_rf <- randomForest(
x          = df_train[, x_vars],
y          = as.factor(df_train$high_mortality),
ntree      = 500,
mtry       = 2,
importance = TRUE
)
pred_rf <- predict(mod_rf, df_test[, x_vars], type = "prob")[, 2]
roc_rf  <- pROC::roc(y_test, pred_rf, quiet = TRUE)
auc_rf  <- as.numeric(pROC::auc(roc_rf))
imp_rf <- importance(mod_rf)
imp_df <- data.frame(
feature    = rownames(imp_rf),
importance = imp_rf[, "MeanDecreaseGini"],
row.names  = NULL
) %>%
dplyr::arrange(dplyr::desc(importance))
write.csv(
imp_df,
"tables/feature_importance_simple.csv",
row.names = FALSE
)
rf_summary <- tibble::tibble(
model    = "Random forest",
test_auc = round(auc_rf, 3)
)
model_comparison <- dplyr::bind_rows(lasso_summary, rf_summary)
model_comparison
# choose best model (this is the line that must exist before bootstrap)
best_model <- ifelse(auc_rf >= auc_lasso, "rf", "lasso")
best_model
# confusion-matrix-based metrics
final_pred <- if (best_model == "rf") {
predict(mod_rf, df_test[, x_vars], type = "prob")[, 2]
} else {
predict(mod_lasso, x_test, type = "response")[, 1]
}
final_roc <- pROC::roc(y_test, final_pred, quiet = TRUE)
best_auc  <- as.numeric(pROC::auc(final_roc))
thr_info <- pROC::coords(
final_roc,
"best",
ret = c("threshold", "sensitivity", "specificity")
)
thr   <- as.numeric(thr_info["threshold"])
y_hat <- as.numeric(final_pred >= thr)
cm  <- table(actual = y_test, pred = y_hat)
acc <- sum(diag(cm)) / sum(cm)
metrics_summary <- tibble::tibble(
metric = c("Accuracy", "Sensitivity", "Specificity"),
value  = c(
round(acc, 3),
round(as.numeric(thr_info["sensitivity"]), 3),
round(as.numeric(thr_info["specificity"]), 3)
)
)
metrics_summary
# 6. bootstrap AUC for chosen model
n_boot   <- 400
boot_auc <- numeric(n_boot)
set.seed(42)
for (b in seq_len(n_boot)) {
idx_b <- sample(seq_along(y_train), replace = TRUE)
if (best_model == "rf") {
rf_b <- randomForest(
x     = df_train[idx_b, x_vars],
y     = as.factor(df_train$high_mortality[idx_b]),
ntree = 500,
mtry  = 2
)
pred_b <- predict(rf_b, df_test[, x_vars], type = "prob")[, 2]
} else {
lasso_b <- glmnet(
x_train[idx_b, ], y_train[idx_b],
family = "binomial",
alpha  = 1,
lambda = lambda_star
)
pred_b <- predict(lasso_b, x_test, type = "response")[, 1]
}
boot_auc[b] <- tryCatch(
as.numeric(pROC::auc(pROC::roc(y_test, pred_b, quiet = TRUE))),
error = function(e) NA_real_
)
}
auc_ci <- stats::quantile(boot_auc, probs = c(0.025, 0.975), na.rm = TRUE)
bootstrap_summary <- tibble::tibble(
metric = c("Test AUC", "AUC 95% lower", "AUC 95% upper"),
value  = c(
round(best_auc, 3),
round(auc_ci[1], 3),
round(auc_ci[2], 3)
)
)
bootstrap_summary
# 7. a couple of model plots
pdf("figures/fig2_model_simple.pdf", width = 10, height = 5)
par(mfrow = c(1, 2), mar = c(4, 4, 2.5, 1))
plot(roc_lasso,
col = "blue",
lwd = 2,
main = "roc – lasso",
las  = 1)
text(0.6, 0.2,
paste("auc =", round(auc_lasso, 3)),
col = "blue")
plot(roc_rf,
col = "red",
lwd = 2,
main = "roc – random forest",
las  = 1)
text(0.6, 0.2,
paste("auc =", round(auc_rf, 3)),
col = "red")
dev.off()
pdf("figures/fig3_bootstrap_simple.pdf", width = 6, height = 5)
hist(boot_auc,
breaks = 30,
col    = "lightgreen",
border = "white",
main   = paste("bootstrap auc –", best_model),
xlab   = "auc",
las    = 1)
abline(v = median(boot_auc, na.rm = TRUE),
col = "red3", lty = 2, lwd = 2)
abline(v = auc_ci,
col = "orange", lty = 3, lwd = 2)
dev.off()
